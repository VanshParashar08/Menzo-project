# Firebase Configuration
# Replace these placeholder values with your project configuration from Firebase Console:
# Project Settings -> General -> Your apps -> Web apps -> SDK setup and configuration (Config)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# OpenAI API Key — used for AI dish photo generation (gpt-image-1)
# Get yours from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-...your_openai_key_here
